generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  createdAt DateTime @default(now())
  recipes  Recipe[]
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  imageUrl    String
  cookTime    Int
  servings    Int
  difficulty  String
  ingredients String   // JSON
  steps       String   // JSON
  createdAt   DateTime @default(now())
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
}
